# 服务
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data
MODELS_DIR=./models
# 随机 32 字节 base64url 密钥，由 app.scripts.init 自动生成
APP_SECRET=
# 首次启动时在界面设置后写入数据库，此处可留空；留空的话务必不要在等号后面加空格或注释，
# 否则会被当成非空密码读取
FAMILY_PASSWORD=

# 模型（界面中也可配置，环境变量作为初始值）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_PRIMARY=doubao-seed-evolving
MODEL_BASELINE=doubao-seed-2-1-pro-260628

# 可选
SOFFICE_PATH=
HTTP_PROXY=
EVAL_MODE=false
